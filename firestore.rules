rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Colección "libros": cada documento es un libro de un usuario.
    match /libros/{libroId} {

      // Revisa que los datos del libro sean válidos
      function datosValidos(libro) {
        // Solo se permiten estos campos (no se pueden agregar otros)
        return libro.keys().hasOnly(['titulo', 'autor', 'genero', 'estado', 'ownerId', 'portada', 'googleId'])
          && libro.titulo is string && libro.titulo.size() > 0 && libro.titulo.size() <= 100
          && libro.autor is string && libro.autor.size() > 0 && libro.autor.size() <= 100
          && libro.genero is string && libro.genero.size() <= 50
          && libro.estado in ['Quiero leer', 'Leyendo', 'Leído']
          // portada y googleId vienen de Google Books y son opcionales
          && (!('portada' in libro) || (libro.portada is string && libro.portada.size() <= 1000
              && (libro.portada == '' || libro.portada.matches('https://.*'))))
          && (!('googleId' in libro) || (libro.googleId is string && libro.googleId.size() <= 40));
      }

      // CONSULTAR y ELIMINAR: solo el dueño del libro
      allow read, delete: if request.auth != null
        && resource.data.ownerId == request.auth.uid;

      // AGREGAR: con sesión, a nombre propio y con datos válidos
      allow create: if request.auth != null
        && request.resource.data.ownerId == request.auth.uid
        && datosValidos(request.resource.data);

      // MODIFICAR: solo el dueño, sin cambiar el dueño y con datos válidos
      allow update: if request.auth != null
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == resource.data.ownerId
        && datosValidos(request.resource.data);
    }

    // Cualquier otra colección queda bloqueada (no hay ninguna regla que la permita).
  }
}
